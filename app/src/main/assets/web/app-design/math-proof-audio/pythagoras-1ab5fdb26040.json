  "cues": [
    {
      "stage": 0,
      "text": "先确认直角：a、b 是直角边，c 是斜边。",
      "start": 0.0,
      "end": 5.6974
    },
    {
      "stage": 0,
      "text": "取四个完全一样的直角三角形，每块面积都是 ab÷2。",
      "start": 5.6974,
      "end": 12.8816
    },
    {
      "stage": 1,
      "text": "第一种摆法：外框边长 a+b，中间四条边都是斜边 c。",
      "start": 12.8816,
      "end": 20.7632
    },
    {
      "stage": 1,
      "text": "两锐角和为90度，中间四角也为直角，所以剩下的是面积 c² 的正方形。",
      "start": 20.7632,
      "end": 31.8947
    },
    {
      "stage": 2,
      "text": "再看第二种摆法：把同样的四块平移，重新安排位置。",
      "start": 31.8947,
      "end": 37.7237
    },
    {
      "stage": 2,
      "text": "编号一一对应；没有拉伸，每块的形状、大小和面积都不变。",
      "start": 37.7237,
      "end": 45.6052
    },
    {
      "stage": 3,
      "text": "现在留下两个正方形，边长分别是 a、b，面积和是 a²+b²。",
      "start": 45.6052,
      "end": 54.1579
    },
    {
      "stage": 3,
      "text": "相同外框减去相同四块，剩余面积相等：c²＝a²+b²。",
      "start": 54.1579,
      "end": 66.144
    }
  ]
}