  "cues": [
    {
      "stage": 0,
      "text": "大正方形边长是 a，小正方形边长是 b。先取 a＞b＞0。",
      "start": 0.0,
      "end": 8.1974
    },
    {
      "stage": 0,
      "text": "想一想：去掉小正方形，剩下的面积还能怎样计算？",
      "start": 8.1974,
      "end": 13.75
    },
    {
      "stage": 1,
      "text": "拿走面积为 b² 的小正方形，剩下一个 L 形。",
      "start": 13.75,
      "end": 18.5658
    },
    {
      "stage": 1,
      "text": "沿虚线剪开：蓝色块长 a、宽 a−b；橙色块长 b、宽 a−b。",
      "start": 18.5658,
      "end": 27.5132
    },
    {
      "stage": 2,
      "text": "先把蓝色块平移到右边，再将橙色块旋转90度。",
      "start": 27.5132,
      "end": 32.7895
    },
    {
      "stage": 2,
      "text": "把两块拼在一起。它们没有拉伸，也没有增减，面积不变。",
      "start": 32.7895,
      "end": 38.9605
    },
    {
      "stage": 3,
      "text": "新长方形的长是 a+b，宽是 a−b。",
      "start": 38.9605,
      "end": 44.2632
    },
    {
      "stage": 3,
      "text": "同一块剩余面积，两种算法：a²−b²＝(a+b)(a−b)。",
      "start": 44.2632,
      "end": 56.784
    }
  ]
}