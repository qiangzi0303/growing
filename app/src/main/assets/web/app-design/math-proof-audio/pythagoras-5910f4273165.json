  "cues": [
    {
      "stage": 0,
      "text": "直角三角形有一个90°角。夹着直角的是直角边，直角所对的是斜边。",
      "start": 0.0,
      "end": 14.5
    },
    {
      "stage": 0,
      "text": "勾股定理：两直角边的平方和等于斜边的平方，即 a²+b²=c²。",
      "start": 14.5,
      "end": 32.2895
    },
    {
      "stage": 1,
      "text": "第一种摆法：外框边长 a+b，中间四条边都是斜边 c。",
      "start": 32.2895,
      "end": 40.171
    },
    {
      "stage": 1,
      "text": "两锐角和为90度，中间四角也为直角，所以剩下的是面积 c² 的正方形。",
      "start": 40.171,
      "end": 51.3026
    },
    {
      "stage": 2,
      "text": "再看第二种摆法：把同样的四块平移，重新安排位置。",
      "start": 51.3026,
      "end": 57.1316
    },
    {
      "stage": 2,
      "text": "编号一一对应；没有拉伸，每块的形状、大小和面积都不变。",
      "start": 57.1316,
      "end": 65.0132
    },
    {
      "stage": 3,
      "text": "现在留下两个正方形，边长分别是 a、b，面积和是 a²+b²。",
      "start": 65.0132,
      "end": 73.5658
    },
    {
      "stage": 3,
      "text": "相同外框减去相同四块，剩余面积相等：c²＝a²+b²。",
      "start": 73.5658,
      "end": 85.56
    }
  ]
}