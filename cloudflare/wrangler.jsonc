{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "growing-platform",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],
  "queues": {
    "producers": [{ "binding": "PHOTO_PROCESSING_QUEUE", "queue": "growing-photo-processing" }],
    "consumers": [{ "queue": "growing-photo-processing", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 5, "retry_delay": 60, "max_concurrency": 2 }]
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "routes": [{ "pattern": "007yx.com/*", "zone_name": "007yx.com" }],
  "kv_namespaces": [{ "binding": "APK_FILES", "id": "d4791757e7614d3f91d25e069610de66" }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "growing-db",
    "database_id": "4c05083b-7ab5-4175-b3d6-9ac944b61716",
    "remote": true,
    "migrations_dir": "migrations"
  }],
  "build": { "command": "python ../scripts/build-worker-assets.py" },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }, { "name": "AI_LIMITER", "namespace_id": "1002", "simple": { "limit": 6, "period": 60 } }, { "name": "AI_USAGE_LIMITER", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } }]
}
