{
  "name": "growing-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "assets": "python ../scripts/build-worker-assets.py",
    "bundle": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply growing-db --local",
    "db:remote": "wrangler d1 migrations apply growing-db --remote"
  },
  "dependencies": {},
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261022.1",
    "@types/node": "22.18.0",
    "miniflare": "5.20261019.1-beta",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "wrangler": "4.151.3"
  }
}
