    "sha256": "dd3fb515a5d9e9273c0cb37c92bc181bd00c23de73f24a31c208c8b93dc90eab",
    "cues": [
      {
        "stage": 0,
        "text": "因式分解：把多项式化成整式的积。平方差等于两数的和与差的积。",
        "start": 0.0,
        "end": 12.75
      },
      {
        "stage": 0,
        "text": "公式中的 a、b 可代表数或整式；这个面积模型取 a＞b＞0。",
        "start": 12.75,
        "end": 33.0
      },
      {
        "stage": 1,
        "text": "拿走面积为 b² 的小正方形，剩下一个 L 形。",
        "start": 33.0,
        "end": 37.8158
      },
      {
        "stage": 1,
        "text": "沿虚线剪开：蓝色块长 a、宽 a−b；橙色块长 b、宽 a−b。",
        "start": 37.8158,
        "end": 46.7632
      },
      {
        "stage": 2,
        "text": "先把蓝色块平移到右边，再将橙色块旋转90度。",
        "start": 46.7632,
        "end": 52.0395
      },
      {
        "stage": 2,
        "text": "把两块拼在一起。它们没有拉伸，也没有增减，面积不变。",
        "start": 52.0395,
        "end": 58.2105
      },
      {
        "stage": 3,
        "text": "新长方形的长是 a+b，宽是 a−b。",
        "start": 58.2105,
        "end": 63.5132
      },
      {
        "stage": 3,
        "text": "同一块剩余面积，两种算法：a²−b²＝(a+b)(a−b)。",
        "start": 63.5132,
        "end": 76.032
      }
    ]
  },
  "pythagoras": {
    "file": "math-proof-audio/pythagoras-5910f4273165.mp3",
    "duration": 85.56,
    "voice": "zh-CN-YunxiNeural",
    "rate": "-5%",
    "sha256": "1e66338555d74693887b2dddb051085978e8b5d1bb3cf5bb631a3c22c9ee5460",
    "cues": [
      {
        "stage": 0,
        "text": "直角三角形有一个90°角。夹着直角的是直角边，直角所对的是斜边。",
        "start": 0.0,
        "end": 14.5
      },
      {
        "stage": 0,
        "text": "勾股定理：两直角边的平方和等于斜边的平方，即 a²+b²=c²。",
        "start": 14.5,
        "end": 32.2895
      },
      {
        "stage": 1,
        "text": "第一种摆法：外框边长 a+b，中间四条边都是斜边 c。",
        "start": 32.2895,
        "end": 40.171
      },
      {
        "stage": 1,
        "text": "两锐角和为90度，中间四角也为直角，所以剩下的是面积 c² 的正方形。",
        "start": 40.171,
        "end": 51.3026
      },
      {
        "stage": 2,
        "text": "再看第二种摆法：把同样的四块平移，重新安排位置。",
        "start": 51.3026,
        "end": 57.1316
      },
      {
        "stage": 2,
        "text": "编号一一对应；没有拉伸，每块的形状、大小和面积都不变。",
        "start": 57.1316,
        "end": 65.0132
      },
      {
        "stage": 3,
        "text": "现在留下两个正方形，边长分别是 a、b，面积和是 a²+b²。",
        "start": 65.0132,
        "end": 73.5658
      },
      {
        "stage": 3,
        "text": "相同外框减去相同四块，剩余面积相等：c²＝a²+b²。",
        "start": 73.5658,
        "end": 85.56
      }
    ]
  }
}
